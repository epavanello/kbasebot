{
  "name": "kbasebot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "yarn dev:app & yarn dev:widget",
    "dev:app": "next dev",
    "dev:widget": "parcel watch widget/embed.ts --dist-dir public --no-source-maps",
    "build": "yarn build:widget && yarn build:app",
    "build:app": "next build",
    "build:widget": "parcel build widget/embed.ts --dist-dir public --no-source-maps",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "supabase:generate-types": "supabase gen types typescript --linked > src/lib/types/database.types.ts",
    "stripe:listen-local-payment": "stripe listen --forward-to localhost:3000/api/stripe"
  },
